<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_work_document_list" model="ir.ui.view">
        <field name="name">work.document.list</field>
        <field name="model">work.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="document_type_id"/>
                <field name="title"/>
                <field name="description"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_work_document_form" model="ir.ui.view">
        <field name="name">work.document.form</field>
        <field name="model">work.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="document_type_id"/>
                        <field name="title"/>
                        <field name="description"/>
                        <field name="attachment_id"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_work_document" model="ir.actions.act_window">
        <field name="name">Documentos de Obra</field>
        <field name="res_model">work.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie seu primeiro documento de obra
            </p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_work_property_list" model="ir.ui.view">
        <field name="name">work.property.list</field>
        <field name="model">work.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="lot_number"/>
                <field name="address"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_work_property_form" model="ir.ui.view">
        <field name="name">work.property.form</field>
        <field name="model">work.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="lot_number"/>
                        <field name="address"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_work_property" model="ir.actions.act_window">
        <field name="name">Propriedades de Obra</field>
        <field name="res_model">work.property</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie sua primeira propriedade de obra
            </p>
        </field>
    </record>
</odoo>

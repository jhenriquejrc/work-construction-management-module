<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_work_type_list" model="ir.ui.view">
        <field name="name">work.type.list</field>
        <field name="model">work.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_work_type_form" model="ir.ui.view">
        <field name="name">work.type.form</field>
        <field name="model">work.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Tipo de Demanda"/>
                    </h1>
                    <group>
                        <field name="active"/>
                        <field name="description" placeholder="Descrição do tipo de demanda"/>
                    </group>
                    <notebook>
                        <page string="Documentos Requeridos">
                            <field name="work_document_type_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="required"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_work_type" model="ir.actions.act_window">
        <field name="name">Tipos de Demanda</field>
        <field name="res_model">work.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie seu primeiro tipo de demanda
            </p>
        </field>
    </record>
</odoo>
